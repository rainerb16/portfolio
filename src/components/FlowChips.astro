---
// A small "A → B → C" flow. Screen readers get it as one sentence.
interface Props {
  items: string[];
  highlight?: number;
  size?: 'md' | 'sm';
  framed?: boolean;
}

const { items, highlight, size = 'md', framed = false } = Astro.props;
const label = `Flow: ${items.join(', then ')}`;
---

<div
  class:list={['flow', `flow--${size}`, { 'flow--framed': framed }]}
  data-flowbox
  role="img"
  aria-label={label}
>
  <span class="pulse" data-pulse aria-hidden="true"></span>
  {items.map((item, i) => (
    <>
      {i > 0 && (
        <span class="arrow" data-arrow aria-hidden="true">
          →
        </span>
      )}
      <span class:list={['chip', { 'chip--highlight': i === highlight }]} data-chip>
        {item}
      </span>
    </>
  ))}
</div>

<style>
  .flow {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text);
  }

  .flow--sm {
    gap: 6px;
    font-size: 0.75rem;
    color: var(--text-2);
  }

  .flow--framed {
    padding: 18px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  .chip {
    padding: 8px 12px;
    border: 1px solid var(--line-3);
    border-radius: var(--radius-sm);
  }

  .flow--sm .chip {
    padding: 5px 9px;
    border-radius: 6px;
  }

  .chip--highlight {
    border-color: var(--blue);
    color: var(--blue-soft);
  }

  .arrow {
    color: var(--coral);
  }

  .pulse {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow:
      0 0 16px var(--coral),
      0 0 4px var(--coral-soft);
    opacity: 0;
    pointer-events: none;
  }
</style>
