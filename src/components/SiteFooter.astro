---
interface Props {
  note?: string;
}
const { note = 'built with Astro · Vue · GSAP · Three.js' } = Astro.props;
---

<footer class="site-footer">
  <div class="container inner mono">
    <span>made by rainer b. · calgary</span>
    <span>{note}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: 28px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
