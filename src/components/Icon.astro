---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  tone?: 'blue' | 'coral';
  size?: number;
}

const { name, tone = 'blue', size = 28 } = Astro.props;
---

<svg
  class:list={['icon', `icon--${tone}`]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>

<style>
  .icon--blue {
    color: var(--blue);
  }
  .icon--coral {
    color: var(--coral);
  }
</style>
