---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found · Rainer B." description="This page doesn't exist." ogImage="/og/home.png">
  <section class="not-found">
    <div class="container stack">
      <p class="eyebrow" data-hero>
        404
      </p>
      <h1 data-hero>This page doesn't exist.</h1>
      <p class="lead" data-hero>
        It may have moved when the site was rebuilt.
      </p>
      <p data-hero>
        <a class="btn btn--primary" href="/">
          Go to the home page
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(96px, 14vw, 180px);
  }

  .stack {
    gap: 24px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
</style>
